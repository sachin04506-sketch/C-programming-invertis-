import datetime

print("Welcome to ATM Machine")

password = 1645
balance = 20000
transactions = []
attempt = 0
max_attempts = 3

# PIN check
while attempt < max_attempts:
    pin = int(input("Enter your 4-digit PIN: "))

    if pin == password:
        print("\nAccess Granted ")

        while True:
            print("\n--- Select an option ---")
            print("1. Check Balance")
            print("2. Deposit Money")
            print("3. Withdraw Money")
            print("4. Mini Statement")
            print("5. Exit")

            choice = int(input("Enter choice (1-5): "))

            if choice == 1:
                print(f"Current Balance: Rs {balance}")

            elif choice == 2:
                deposit = int(input("Enter amount to deposit: Rs "))
                balance += deposit
                time = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                transactions.append((time, f"Deposited Rs {deposit}"))
                print(f"Deposit successful  New Balance: Rs {balance}")

            elif choice == 3:
                withdraw = int(input("Enter amount to withdraw: Rs "))
                if withdraw <= balance:
                    balance -= withdraw
                    time = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                    transactions.append((time, f"Withdrawn Rs {withdraw}"))
                    print(f"Withdraw successful Remaining Balance: Rs {balance}")
                else:
                    print("Insufficient funds")

            elif choice == 4:
                print("\n--- Mini Statement ---")
                if not transactions:
                    print("No transactions yet")
                else:
                    for t in transactions:
                        print(f"{t[0]} -> {t[1]}")
                print(f"Available Balance: Rs {balance}")

            elif choice == 5:
                print("Thank you for using ATM ")
                break

            else:
                print(" Invalid input (choose 1-5)")

        break   # exit after successful login

    else:
        attempt += 1
        remaining = max_attempts - attempt
        print(f" Incorrect PIN! Attempts left: {remaining}")

        if remaining == 0:
            print(" Card blocked. Try again later.")
